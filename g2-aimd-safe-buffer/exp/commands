# Set to 1 to skip completed runs, 0 to always rerun.
SKIP_COMPLETED=1

run_case() {
    local logfile="logs/$1"
    shift

    if [ "$SKIP_COMPLETED" -eq 1 ] && [ -f "$logfile" ]; then
        if grep -q "Total time" "$logfile" || grep -q "STATUS: TIMEOUT" "$logfile"; then
            echo "Skipping $logfile (already completed or timed out)"
            return
        fi
    fi

    {
        echo "CMD: $*"
        echo "START: $(date)"
        echo
    } > "$logfile"

    if timeout 10m "$@" >> "$logfile" 2>&1; then
        {
            echo
            echo "STATUS: OK"
            echo "END: $(date)"
        } >> "$logfile"
    else
        local rc=$?
        {
            echo
            if [ "$rc" -eq 124 ]; then
                echo "STATUS: TIMEOUT after 10m"
            else
                echo "STATUS: FAILED (exit code $rc)"
            fi
            echo "END: $(date)"
        } >> "$logfile"
    fi
}

